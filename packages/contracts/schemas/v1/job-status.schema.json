{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.stockshift.invalid/v1/job-status.schema.json",
  "title": "JobStatus",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1",
      "type": "string"
    },
    "job_id": {
      "$ref": "common.schema.json#/definitions/Uuid"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "retry_wait",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "stage": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_units": {
      "type": "integer",
      "minimum": 0
    },
    "total_units": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "state",
    "stage",
    "completed_units",
    "total_units",
    "failure_code"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "failure_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
