{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.stockshift.invalid/v1/common.schema.json",
  "title": "Common",
  "definitions": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "DecimalString": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(?![\\s\\S])",
      "description": "Exact canonical decimal text. No exponent, symbols, grouping or binary JSON number. Preserve source scale."
    },
    "Score": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "score_type": {
          "enum": [
            "provider_reported",
            "layout_heuristic",
            "matching_heuristic"
          ]
        }
      },
      "required": [
        "value",
        "score_type"
      ],
      "description": "A provider/heuristic score, never implicitly a calibrated probability."
    },
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "field",
        "message"
      ]
    },
    "ObjectReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "object_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bucket",
        "object_key"
      ]
    },
    "VersionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "sdk_version": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "provider",
        "sdk_version",
        "model_version",
        "config_hash"
      ]
    }
  }
}
