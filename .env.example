# Server only. Values must come from a newly started LOCAL Supabase stack.
# No standard SUPABASE_* environment variables are read by the upload endpoint.
# The server refuses hosted URLs; permitted API is loopback on port 54321.
# Never expose a secret key through a VITE_ variable. No real values committed.
STOCKSHIFT_LOCAL_SUPABASE_URL=
STOCKSHIFT_LOCAL_SUPABASE_PUBLISHABLE_KEY=
STOCKSHIFT_LOCAL_SUPABASE_SECRET_KEY=
