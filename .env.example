# Server only. Values must come from a newly started LOCAL Supabase stack.
# No standard SUPABASE_* variables are read by the upload endpoint or CSV worker.
# Default local mode permits only the loopback API on port 54321.
# Never expose a secret key through a VITE_ variable. No real values committed.
STOCKSHIFT_LOCAL_SUPABASE_URL=
STOCKSHIFT_LOCAL_SUPABASE_PUBLISHABLE_KEY=
STOCKSHIFT_LOCAL_SUPABASE_SECRET_KEY=
# Server-only, default off. Local CPU inspection only; hosted PDFs remain blocked.
STOCKSHIFT_PDF_INSPECTION_ENABLED=0
# Separate future hosted CPU flags: defaults OFF in API and trusted CPU worker.
STOCKSHIFT_HOSTED_PDF_INSPECTION_ENABLED=0
STOCKSHIFT_HOSTED_PDF_EXTRACTION_ENABLED=0
STOCKSHIFT_OCR_ENABLED=0
VITE_STOCKSHIFT_HOSTED_PDF_INSPECTION_ENABLED=0
VITE_STOCKSHIFT_HOSTED_PDF_EXTRACTION_ENABLED=0
# Browser public values only; npm run dev:local sets these from the local stack.
VITE_STOCKSHIFT_LOCAL_SUPABASE_URL=
VITE_STOCKSHIFT_LOCAL_SUPABASE_PUBLISHABLE_KEY=

# Hosted preview: set these explicitly in Vercel Preview settings, not in Git.
# Local launchers continue using ONLY STOCKSHIFT_LOCAL_* values above.
# Hosted mode accepts HTTPS <project-ref>.supabase.co origins; no custom domains.
# VITE_STOCKSHIFT_SUPABASE_MODE=hosted
# VITE_STOCKSHIFT_SUPABASE_URL=
# VITE_STOCKSHIFT_SUPABASE_PUBLISHABLE_KEY=
# Server only; same isolated preview project as the browser.
# STOCKSHIFT_SUPABASE_MODE=hosted
# STOCKSHIFT_SUPABASE_URL=
# STOCKSHIFT_SUPABASE_PUBLISHABLE_KEY=
# STOCKSHIFT_SUPABASE_SECRET_KEY=
# Do not put STOCKSHIFT_OCR_ENDPOINT / STOCKSHIFT_OCR_TOKEN in Vercel or VITE_*.
# They belong only to a separately hosted trusted CPU worker. That worker is
# supports hosted CSV polling but has not been provisioned.
# Hosted mode defaults to CSV. Future CPU PDF opt-in requires matching flags,
# the reviewed migration and a fresh worker capability advertisement. OCR stays off.
# Optional local reproduction: STOCKSHIFT_CSV_ONLY=1 (launcher mirrors browser flag).
